<?xml version="1.0" encoding="utf-8"?>
<!-- Parkour quadruped URDF with A1-style joint/link names and ordering. -->
<!-- Physical parameters preserved from parkour_quadruped.urdf (Lite3). -->
<robot name="parkour_description" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.913725490196 0.913725490196 0.847058823529 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.12 0.15 0.2 1.0"/>
  </material>
  <material name="brown">
    <color rgba="0.870588235294 0.811764705882 0.764705882353 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="base">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <link name="camera_box">
    <visual>
      <origin rpy="0 0 0" xyz="0.27 0 0.03"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="fixed_camera_box" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base"/>
    <child link="camera_box"/>
  </joint>

  <joint name="floating_base" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base"/>
    <child link="trunk"/>
  </joint>

  <link name="trunk">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <geometry>
        <box size="0.55 0.22 0.13"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <geometry>
        <box size="0.50 0.10 0.12"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.01"/>
      <geometry>
        <box size="0.25 0.20 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="5.6056"/>
      <inertia ixx="0.02456" ixy="0" ixz="0" iyy="0.05518" iyz="0" izz="0.07016"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="trunk"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <!-- ==================== FR Leg (Front Right) ==================== -->
  <joint name="FR_hip_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.1745 -0.062 0"/>
    <parent link="trunk"/>
    <child link="FR_hip"/>
    <axis xyz="-1 0 0"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="24" lower="-0.523" upper="0.523" velocity="26.2"/>
  </joint>
  <link name="FR_hip">
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.08 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="1.57079632 0 0" xyz="0 -0.05 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.010579 0.011358 0.00048546"/>
      <mass value="0.550"/>
      <inertia ixx="0.0004472" ixy="0" ixz="0" iyy="0.0004028" iyz="0" izz="0.0003949"/>
    </inertial>
  </link>
  <joint name="FR_hip_fixed" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.081 0"/>
    <parent link="FR_hip"/>
    <child link="FR_thigh_shoulder"/>
  </joint>
  <link name="FR_thigh_shoulder">
  </link>
  <joint name="FR_thigh_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 -0.09735 0"/>
    <parent link="FR_hip"/>
    <child link="FR_thigh"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="24" lower="-2.67" upper="0.314" velocity="26.2"/>
  </joint>
  <link name="FR_thigh">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.10"/>
      <geometry>
        <cylinder length="0.20" radius="0.022"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.015 0 -0.08"/>
      <geometry>
        <box size="0.04 0.045 0.20"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0039245 0.014632 -0.025146"/>
      <mass value="0.86"/>
      <inertia ixx="0.005736" ixy="0" ixz="0" iyy="0.004960" iyz="0" izz="0.001436"/>
    </inertial>
  </link>
  <joint name="FR_calf_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 -0.20"/>
    <parent link="FR_thigh"/>
    <child link="FR_calf"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="36" lower="0.524" upper="2.792" velocity="17.3"/>
  </joint>
  <link name="FR_calf">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.10506"/>
      <geometry>
        <cylinder length="0.21012" radius="0.015"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 -0.2 0" xyz="0.005 0 -0.03"/>
      <geometry>
        <cylinder length="0.12" radius="0.015"/>
